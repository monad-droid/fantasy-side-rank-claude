{
  "manifest_version": 3,
  "name": "Fantasy Draft Rank Tracker",
  "version": "1.1.1",
  "description": "Paste your fantasy football rankings and automatically cross off players as they're drafted in your ESPN draft room.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://fantasy.espn.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Draft Rank Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["normalize.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
